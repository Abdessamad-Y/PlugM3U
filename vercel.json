{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/files",
      "dest": "/server.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/server.js"
    },
    {
      "src": "/catalog/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/meta/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/stream/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/([^/]+)/manifest.json",
      "dest": "/server.js"
    },
    {
      "src": "/([^/]+)/catalog/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/([^/]+)/meta/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/([^/]+)/stream/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}